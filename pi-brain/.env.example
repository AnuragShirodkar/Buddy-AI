# Copy to .env and fill in

# Hardware endpoints (from ESP serial monitors)
CAM_URL=http://192.168.1.50
MOTOR_URL=http://192.168.1.51
MOTOR_UDP_HOST=192.168.1.51
MOTOR_UDP_PORT=4210
USE_MOTOR_UDP=0

# Cloud vision / LLM — set one provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Motion tuning (milliseconds)
TURN_MS=280
FORWARD_MS=350
SEARCH_TURN_MS=400
DEFAULT_SPEED=170
MAX_MOVE_MS=800
MISSION_TIMEOUT_S=90
CENTER_TOLERANCE=0.12
CLOSE_BBOX_HEIGHT=0.45
MAX_LOST_FRAMES=5

# HTTP command server
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8080

# TTS: espeak | piper | none
TTS_ENGINE=espeak
PIPER_MODEL=
ESPEAK_VOICE=en
